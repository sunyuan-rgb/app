# 复制为 .env（服务运行）与 .env.test（测试）后填写真实值；两者均被 .gitignore 排除。
# 严禁把本文件改成真实口令后提交仓库。

# --- 数据库 ---
# 主服务连接串（含读写账号口令）
APP_DSN=reading:CHANGE_ME@tcp(127.0.0.1:3306)/reading_activity?parseTime=true&loc=UTC
# 测试库基础连接串（以 / 结尾，不带库名；账号需有 CREATE DATABASE 权限）
TEST_DSN=root:CHANGE_ME@tcp(127.0.0.1:3306)/
# 迁移用 root 口令（make db-migrate）
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- 服务 ---
APP_ADDR=:8080
RSVC_ADDR=:8081
MAIN_SVC_URL=http://localhost:8080
READING_SVC_URL=http://localhost:8081
# 事件接入令牌（教学假设 A-01，教学环境演示值，非生产密钥）
EVENTS_TOKEN=teach-events-token
# 教学时钟偏移（演示跨日/窗口关闭场景时使用，如 24h、50h）
# TEACH_CLOCK_OFFSET=
